APP_NAME="UTS Keamanan - Soaloon Mt Sianturi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Simulasi HTTPS (soal E.2). Ubah ke true bila Laragon SSL aktif / ingin demo HTTPS.
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uts_keamanan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
